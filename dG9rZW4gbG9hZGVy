local v=i.."/verify?token="..u
local w,x=pcall(function()
    return game:HttpGet(v)
end)

if not w or x~="valid" then
    j:Kick("wrong token bucko")
    return
end

_G.USER_TOKEN=k

local y=i.."/?token="..u
local z,aa=pcall(function()
    return game:HttpGet(y)
end)

