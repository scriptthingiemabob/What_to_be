local function urlEncode(str)
    return tostring(str):gsub("%%","%%25"):gsub(" ","%20")
end

local function getHWID()
    if syn and syn.crypt and syn.crypt.hwid then
        return syn.crypt.hwid()
    elseif getexecutorname and getexecutorname() == "Delta" then
        return (syn and syn.crypt and syn.crypt.hwid) or "unknown"
    else
        return "unknown"
    end
end

