local function urlEncode(str)
    return tostring(str):gsub("%%","%%25"):gsub(" ","%20")
end

local function getHWID()
    if syn and syn.crypt and syn.crypt.hwid then
        return syn.crypt.hwid()
    elseif getexecutorname and getexecutorname() == "Delta" then
        return (syn and syn.crypt and syn.crypt.hwid) or "unknown"
    else
        return "unknown"
    end
end

local token = k
local hwid = getHWID()
local tokenEnc = urlEncode(token)
local hwidEnc = urlEncode(hwid)

local verifyURL = i.."/verify?token="..tokenEnc.."&hwid="..hwidEnc
local ok, resp = pcall(function()
    return game:HttpGet(verifyURL)
end)

if not ok then
    j:Kick("wrong token bucko")
    return
end

if resp == "wrong hwid" then
    j:Kick("This key is already bound to another device.")
    return
elseif resp ~= "valid" then
    j:Kick("wrong token bucko")
    return
end

_G.USER_TOKEN = token

local mainURL = i.."/?token="..tokenEnc.."&hwid="..hwidEnc
local scrOk, scr = pcall(function()
    return game:HttpGet(mainURL)
end)

if not scrOk then
    error("Failed to fetch script: "..tostring(scr))
end

local fn, err = loadstring(scr)
if not fn then
    error("Loadstring error: "..tostring(err))
end

fn()
